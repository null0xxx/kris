# Byte-compiled / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments (ADR-005 venv lives at ~/.local/share/lsassist/venv)
.venv/
venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Branch-coverage measurement data (T2.13 / ADR-011). `coverage run` drops
# `.coverage` in the repo root; `--parallel-mode` adds `.coverage.<host>.<pid>.<n>`.
.coverage
.coverage.*

# Secrets — never commit (SPEC §13 / I8)
*.key
*.pem
secrets*
# ...but source modules may legitimately carry the name (T1.09)
!src/lsassist/config/secrets.py
